# =====================================================================
# Plantilla de variables para PRODUCCION (VPS).
# Copiar a `.env` en el VPS y rellenar. NUNCA commitear este archivo lleno.
# Version dev (con MailHog): ver `.env.example`.
# =====================================================================

APP_NAME=Vibeer
APP_ENV=production
APP_KEY=                 # generar: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://api.vibeer.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres         # nombre del servicio en docker-compose
DB_PORT=5432
DB_DATABASE=vibeer_production
DB_USERNAME=vibeer
DB_PASSWORD=SECRETO_FUERTE_20_CARACTERES

# Dominio de la SPA (para CORS y URLs de la app)
FRONTEND_APP=https://vibeer.com

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP REAL (no MailHog)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CUENTA_REAL@gmail.com
MAIL_PASSWORD=APP_PASSWORD_O_CONTRASENA
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@vibeer.com"
MAIL_FROM_NAME="Vibeer"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# OAuth: redirects deben apuntar a la SPA de produccion
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_KEY=
GOOGLE_REDIRECT_URL=https://vibeer.com/authorize/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=https://vibeer.com/authorize/facebook/callback

# Secretos: generar con --force en el VPS
JWT_SECRET=              # php artisan jwt:secret --force

GOOGLE_MAPS_API_KEY=TU_API_KEY_GOOGLE_MAPS_PRODUCCION

# Nota: OpenPay se configura desde el admin (tabla openpay_keys), no aqui.